@model List<diplom.Models.ViewModels.ChatDialogViewModel>

@{
    ViewData["Title"] = "Сообщения";
    var currentUserId = ViewBag.CurrentUserId;
    var allUsers = ViewBag.AllUsers as IEnumerable<dynamic> ?? new List<dynamic>();

    // Функция для получения цвета роли
    string GetColorForRole(string role)
    {
        return role switch
        {
            "Admin" => "#ef4444",
            "Lecturer" => "#22c55e",
            "Student" => "#3b82f6",
            _ => "#6366f1"
        };
    }
}

<div class="chat-container">
    <div class="row g-0">
        <!-- Список диалогов -->
        <div class="col-md-4 col-lg-3 chat-sidebar">
            <div class="chat-sidebar-header">
                <h5 class="mb-0"><i class="fas fa-comments me-2"></i>Чаты</h5>
                <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#newChatModal">
                    <i class="fas fa-plus"></i>
                </button>
            </div>

            <div class="chat-dialogs-list" id="dialogsList">
                @foreach (var dialog in Model)
                {
                    <div class="chat-dialog-item" data-user-id="@dialog.OtherUserId" data-dialog-id="@dialog.DialogId">
                        <div class="chat-dialog-avatar">
                            <div class="avatar-circle" style="background: @GetColorForRole(dialog.Role)">
                                @(dialog.OtherUserFullName.FirstOrDefault().ToString().ToUpper())
                            </div>
                        </div>
                        <div class="chat-dialog-info">
                            <div class="d-flex justify-content-between">
                                <strong class="chat-dialog-name">@dialog.OtherUserFullName</strong>
                                <small class="text-muted">@dialog.LastMessageAt.ToString("HH:mm")</small>
                            </div>
                            <div class="d-flex justify-content-between">
                                <small class="text-muted chat-dialog-lastmsg">@(dialog.LastMessage.Length > 30 ? dialog.LastMessage.Substring(0, 30) + "..." : dialog.LastMessage)</small>
                                @if (dialog.UnreadCount > 0)
                                {
                                    <span class="badge bg-danger rounded-pill unread-badge">@dialog.UnreadCount</span>
                                }
                            </div>
                        </div>
                    </div>
                }

                @if (!Model.Any())
                {
                    <div class="text-center text-muted p-4">
                        <i class="fas fa-inbox fa-3x mb-2"></i>
                        <p>Нет сообщений</p>
                        <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#newChatModal">
                            Начать чат
                        </button>
                    </div>
                }
            </div>
        </div>

        <!-- Область сообщений -->
        <div class="col-md-8 col-lg-9 chat-messages-area">
            <div class="chat-messages-header" id="chatHeader" style="display: none;">
                <div class="d-flex align-items-center">
                    <div class="avatar-circle me-2" id="chatAvatar" style="width: 40px; height: 40px; font-size: 1rem;">U</div>
                    <div>
                        <h6 class="mb-0" id="chatUserName"></h6>
                        <small class="text-muted" id="chatUserRole"></small>
                    </div>
                </div>
            </div>

            <div class="chat-messages-container" id="messagesContainer">
                <div class="text-center text-muted p-5" id="noChatSelected">
                    <i class="fas fa-comment-dots fa-4x mb-3"></i>
                    <p>Выберите чат для начала общения</p>
                </div>
                <div id="messagesList" class="messages-list"></div>
            </div>

            <div class="chat-input-area" style="display: none;" id="chatInputArea">
                <div class="input-group">
                    <input type="text" class="form-control" id="messageInput" placeholder="Введите сообщение..." />
                    <button class="btn btn-primary" id="sendMessageBtn">
                        <i class="fas fa-paper-plane"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Модальное окно нового чата -->
<div class="modal fade" id="newChatModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-user-plus me-2"></i>Новый чат</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="text" class="form-control" id="searchUserInput" placeholder="Поиск пользователя..." />
                <div class="mt-3" id="usersList">
                    @foreach (var user in allUsers)
                    {
                        <div class="user-item" data-user-id="@user.Id">
                            <div class="d-flex align-items-center justify-content-between p-2 border-bottom">
                                <div>
                                    <strong>@user.FullName</strong>
                                    <br />
                                    <small class="text-muted">@@@user.UserName</small>
                                </div>
                                <span class="badge bg-secondary">@user.Role</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .chat-container {
        background: var(--bg-card);
        border-radius: 0.75rem;
        overflow: hidden;
        box-shadow: var(--shadow-md);
        height: calc(100vh - 150px);
        min-height: 500px;
    }

    .chat-sidebar {
        background: var(--bg-secondary);
        border-right: 1px solid var(--border-color);
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .chat-sidebar-header {
        padding: 1rem;
        border-bottom: 1px solid var(--border-color);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .chat-dialogs-list {
        flex: 1;
        overflow-y: auto;
    }

    .chat-dialog-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem 1rem;
        cursor: pointer;
        transition: background 0.2s ease;
        border-bottom: 1px solid var(--border-color);
    }

        .chat-dialog-item:hover {
            background: var(--bg-hover);
        }

        .chat-dialog-item.active {
            background: var(--bg-hover);
            border-left: 3px solid var(--accent-primary);
        }

    .chat-dialog-avatar {
        flex-shrink: 0;
    }

    .avatar-circle {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        color: white;
        font-size: 1.2rem;
    }

    .chat-dialog-info {
        flex: 1;
        min-width: 0;
    }

    .chat-dialog-name {
        font-size: 0.9rem;
    }

    .chat-dialog-lastmsg {
        font-size: 0.8rem;
    }

    .unread-badge {
        font-size: 0.7rem;
        padding: 0.25rem 0.5rem;
    }

    .chat-messages-area {
        display: flex;
        flex-direction: column;
        height: 100%;
        background: var(--bg-primary);
    }

    .chat-messages-header {
        padding: 1rem;
        background: var(--bg-card);
        border-bottom: 1px solid var(--border-color);
    }

    .chat-messages-container {
        flex: 1;
        overflow-y: auto;
        padding: 1rem;
    }

    .messages-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .message-item {
        display: flex;
        flex-direction: column;
        max-width: 70%;
    }

        .message-item.mine {
            align-self: flex-end;
        }

        .message-item.other {
            align-self: flex-start;
        }

    .message-bubble {
        padding: 0.5rem 1rem;
        border-radius: 1rem;
        word-wrap: break-word;
    }

    .message-item.mine .message-bubble {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-bottom-right-radius: 0.25rem;
    }

    .message-item.other .message-bubble {
        background: var(--bg-card);
        color: var(--text-primary);
        border-bottom-left-radius: 0.25rem;
        box-shadow: var(--shadow-sm);
    }

    .message-time {
        font-size: 0.7rem;
        color: var(--text-muted);
        margin-top: 0.25rem;
        padding: 0 0.5rem;
    }

    .chat-input-area {
        padding: 1rem;
        background: var(--bg-card);
        border-top: 1px solid var(--border-color);
    }

    .user-item {
        cursor: pointer;
        transition: background 0.2s ease;
    }

        .user-item:hover {
            background: var(--bg-hover);
        }

    @@media (max-width: 768px) {
        .chat-sidebar {
            position: absolute;
            z-index: 10;
            width: 100%;
            height: 100%;
            transform: translateX(-100%);
            transition: transform 0.3s ease;
        }

            .chat-sidebar.open {
                transform: translateX(0);
            }

        .message-item {
            max-width: 85%;
        }
    }
</style>

<script>
    let currentUserId = @currentUserId;
    let currentDialogId = null;
    let currentOtherUserId = null;
    let pollingInterval = null;
    let isChatSidebarOpen = window.innerWidth > 768;

    // Функция для получения цвета роли (JS версия)
    function getRoleColorJs(role) {
        const colors = {
            'Admin': '#ef4444',
            'Lecturer': '#22c55e',
            'Student': '#3b82f6'
        };
        return colors[role] || '#6366f1';
    }

    // Открытие диалога
    function openDialog(userId, dialogId) {
        currentOtherUserId = userId;

        $.get(`/Chat/Dialog?userId=${userId}`, function (data) {
            if (data.success) {
                currentDialogId = data.dialogId;

                // Обновляем хедер
                $('#chatHeader, #chatInputArea').show();
                $('#noChatSelected').hide();
                $('#chatUserName').text(data.otherUser.name);
                $('#chatUserRole').text(data.otherUser.role);

                // Обновляем аватар
                const initial = data.otherUser.name?.charAt(0)?.toUpperCase() || 'U';
                $('#chatAvatar').text(initial);
                $('#chatAvatar').css('background', getRoleColorJs(data.otherUser.role));

                // Отображаем сообщения
                $('#messagesList').empty();
                data.messages.forEach(msg => {
                    appendMessage(msg);
                });

                // Помечаем диалог как активный
                $('.chat-dialog-item').removeClass('active');
                $(`.chat-dialog-item[data-user-id="${userId}"]`).addClass('active');

                // Сбрасываем счетчик непрочитанных
                $(`.chat-dialog-item[data-user-id="${userId}"] .unread-badge`).remove();

                // Прокрутка вниз
                scrollToBottom();

                // Запускаем поллинг для этого диалога
                if (pollingInterval) clearInterval(pollingInterval);
                pollingInterval = setInterval(() => pollNewMessages(userId), 3000);
            }
        });
    }

    function appendMessage(msg) {
        const messageClass = msg.isMine ? 'mine' : 'other';
        const time = new Date(msg.sentAt).toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' });

        const messageHtml = `
                <div class="message-item ${messageClass}" data-message-id="${msg.id}">
                    <div class="message-bubble">
                        ${escapeHtml(msg.message)}
                    </div>
                    <div class="message-time ${messageClass === 'mine' ? 'text-end' : ''}">
                        ${time}
                        ${msg.isMine && msg.isRead ? '<i class="fas fa-check-double ms-1"></i>' : ''}
                    </div>
                </div>
            `;
        $('#messagesList').append(messageHtml);
    }

    function pollNewMessages(userId) {
        if (currentOtherUserId !== userId) return;

        $.get(`/Chat/Dialog?userId=${userId}`, function (data) {
            if (data.success && data.messages) {
                const existingIds = new Set();
                $('.message-item').each(function () {
                    const id = $(this).data('message-id');
                    if (id) existingIds.add(id);
                });

                data.messages.forEach(msg => {
                    if (!existingIds.has(msg.id)) {
                        appendMessage(msg);
                    }
                });

                // Обновляем статус прочитанных
                if (data.messages.some(m => !m.isMine && !m.isRead)) {
                    markAsRead(userId);
                }

                scrollToBottom();
            }
        });
    }

    function markAsRead(senderId) {
        $.post('/Chat/MarkAsRead', { senderId: senderId });
    }

    function sendMessage() {
        const message = $('#messageInput').val().trim();
        if (!message || !currentOtherUserId) return;

        $('#messageInput').val('');

        $.post('/Chat/SendMessage', { recipientId: currentOtherUserId, message: message }, function (data) {
            if (data.success) {
                appendMessage({
                    id: data.message.id,
                    message: data.message.message,
                    sentAt: data.message.sentAt,
                    isMine: true,
                    isRead: false
                });
                scrollToBottom();

                // Обновляем последнее сообщение в списке диалогов
                $(`.chat-dialog-item[data-user-id="${currentOtherUserId}"] .chat-dialog-lastmsg`).text(
                    message.length > 30 ? message.substring(0, 30) + '...' : message
                );
            }
        });
    }

    function scrollToBottom() {
        const container = $('.chat-messages-container');
        container.scrollTop(container[0].scrollHeight);
    }

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    // Обработчики событий
    $(document).ready(function () {
        // Клик по диалогу
        $(document).on('click', '.chat-dialog-item', function () {
            const userId = $(this).data('user-id');
            openDialog(userId);

            if (window.innerWidth < 768) {
                $('.chat-sidebar').removeClass('open');
            }
        });

        // Клик по пользователю для нового чата
        $(document).on('click', '.user-item', function () {
            const userId = $(this).data('user-id');
            $('#newChatModal').modal('hide');
            openDialog(userId);

            // Добавляем в список диалогов, если его там нет
            if ($(`.chat-dialog-item[data-user-id="${userId}"]`).length === 0) {
                location.reload();
            }
        });

        // Отправка сообщения
        $('#sendMessageBtn').click(sendMessage);
        $('#messageInput').keypress(function (e) {
            if (e.key === 'Enter') sendMessage();
        });

        // Поиск пользователей
        $('#searchUserInput').on('input', function () {
            const search = $(this).val().toLowerCase();
            $('.user-item').each(function () {
                const text = $(this).text().toLowerCase();
                $(this).toggle(text.includes(search));
            });
        });

        // Мобильное меню чатов
        if (window.innerWidth < 768) {
            $('.chat-sidebar-header button').on('click', function (e) {
                e.stopPropagation();
                $('.chat-sidebar').toggleClass('open');
            });
        }

        // Получение количества непрочитанных
        setInterval(function () {
            $.get('/Chat/GetUnreadCount', function (data) {
                if (data.count > 0) {
                    document.title = data.count > 0 ? `(${data.count}) Чат` : 'Сообщения';
                } else {
                    document.title = 'Сообщения';
                }
            });
        }, 10000);
    });
</script>