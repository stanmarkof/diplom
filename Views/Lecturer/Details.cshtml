@model diplom.Models.Discipline

@{
    ViewData["Title"] = Model.Name;
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <h3 class="mb-0">@Model.Name</h3>
            <small class="text-muted">
                <i class="fas fa-graduation-cap"></i> @Model.Course?.Code - @Model.Course?.Name
                | <i class="fas fa-calendar"></i> @Model.CourseNumber курс, @Model.Semester семестр
            </small>
        </div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
            <i class="fas fa-edit"></i> Редактировать
        </a>
    </div>
    <div class="card-body">
        <!-- Описание -->
        <div class="mb-4">
            <h5><i class="fas fa-info-circle"></i> Описание</h5>
            <p>@(string.IsNullOrEmpty(Model.Description) ? "Описание отсутствует" : Model.Description)</p>
        </div>

        <!-- Материалы -->
        <div class="mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5><i class="fas fa-file-alt"></i> Учебные материалы</h5>
                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addMaterialModal">
                    <i class="fas fa-plus"></i> Добавить материал
                </button>
            </div>

            @if (Model.Materials != null && Model.Materials.Any())
            {
                <div class="list-group">
                    @foreach (var material in Model.Materials)
                    {
                        <div class="list-group-item bg-transparent">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <i class="fas fa-file-alt me-2"></i>
                                    <span class="text-decoration-none">@material.Title</span>
                                </div>
                                <div>
                                    <button type="button" class="btn btn-sm btn-danger" onclick="deleteMaterial(@material.Id)">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </div>
                            <small class="text-muted">Добавлено: @material.UploadedAt.ToString("dd.MM.yyyy")</small>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i> Материалы отсутствуют
                </div>
            }
        </div>

        <!-- Тесты -->
        <div class="mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5><i class="fas fa-tasks"></i> Тесты</h5>
                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addTestModal">
                    <i class="fas fa-plus"></i> Создать тест
                </button>
            </div>

            @if (Model.Tests != null && Model.Tests.Any())
            {
                <div class="list-group">
                    @foreach (var test in Model.Tests)
                    {
                        <div class="list-group-item bg-transparent">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <i class="fas fa-file-alt me-2"></i>
                                    <span class="text-decoration-none">@test.Title</span>
                                    @if (test.Deadline.HasValue)
                                    {
                                        <small class="text-muted">Дедлайн: @test.Deadline.Value.ToString("dd.MM.yyyy")</small>
                                    }
                                </div>
                                <div>
                                    <button type="button" class="btn btn-sm btn-warning" onclick="editTest(@test.Id)">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-danger" onclick="deleteTest(@test.Id)">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i> Тесты отсутствуют
                </div>
            }
        </div>
    </div>
    <div class="card-footer">
        <a asp-action="Index" class="btn btn-secondary">Назад к списку</a>
    </div>
</div>