@model diplom.Models.Test

@{
    ViewData["Title"] = "Редактирование теста";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="mb-0"><i class="fas fa-tasks"></i> Редактирование теста</h3>
        <a asp-action="Edit" asp-route-id="@Model.DisciplineId" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Назад к дисциплине
        </a>
    </div>
    <div class="card-body">
        <!-- Основная информация о тесте -->
        <form asp-action="EditTest" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />

            <div class="row">
                <div class="col-md-8">
                    <div class="mb-3">
                        <label class="form-label">Название теста *</label>
                        <input type="text" name="title" class="form-control" value="@Model.Title" required />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label">Максимальный балл</label>
                        <input type="number" name="maxScore" class="form-control" value="@Model.MaxScore" readonly />
                        <small class="text-muted">Автоматически рассчитывается из суммы баллов вопросов</small>
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Описание</label>
                <textarea name="description" class="form-control" rows="3">@Model.Description</textarea>
            </div>

            <div class="row">
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label">Длительность (минут)</label>
                        <input type="number" name="durationMinutes" class="form-control" value="@Model.DurationMinutes" required />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label">Дедлайн</label>
                        <input type="datetime-local" name="deadline" class="form-control" value="@(Model.Deadline?.ToString("yyyy-MM-ddTHH:mm"))" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label">Раздел</label>
                        <input type="text" class="form-control" value="@Model.Section?.Name" disabled />
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input type="checkbox" class="form-check-input" name="isPublished" id="isPublished" value="true" @(Model.IsPublished ? "checked" : "") />
                            <label class="form-check-label" for="isPublished">
                                <i class="fas fa-globe"></i> Опубликован
                            </label>
                        </div>
                        <input type="hidden" name="isPublished" value="false" />
                        <small class="text-muted">Опубликованные тесты видны студентам</small>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input type="checkbox" class="form-check-input" name="isVisible" id="isVisible" value="true" @(Model.IsVisible ? "checked" : "") />
                            <label class="form-check-label" for="isVisible">
                                <i class="fas fa-eye"></i> Видим для студентов
                            </label>
                        </div>
                        <input type="hidden" name="isVisible" value="false" />
                        <small class="text-muted">Если выключено, студенты не увидят тест</small>
                    </div>
                </div>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">Сохранить изменения</button>
                <a asp-action="Edit" asp-route-id="@Model.DisciplineId" class="btn btn-secondary">Отмена</a>
            </div>
        </form>
    </div>
</div>

<!-- Вопросы теста -->
<div class="card mt-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="fas fa-question-circle"></i> Вопросы теста</h5>
        <a asp-action="AddQuestion" asp-route-testId="@Model.Id" class="btn btn-primary btn-sm">
    <i class="fas fa-plus"></i> Добавить вопрос
</a>
    </div>
    <div class="card-body">
        @if (Model.Questions != null && Model.Questions.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Вопрос</th>
                            <th>Тип</th>
                            <th>Баллы</th>
                            <th>Действия</th>
                        </thead>
                        <tbody>
                            @foreach (var question in Model.Questions.OrderBy(q => q.Id))
                            {
                                <tr>
                                    <td>@question.Id</td>
                                    <td>
                                        <strong>@question.Text</strong>
                                        @if (!string.IsNullOrEmpty(question.OptionsJson))
                                        {
                                            <div class="small text-muted mt-1">
                                                Варианты: @question.OptionsJson
                                            </div>
                                        }
                                     </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(question.OptionsJson))
                                        {
                                            <span class="badge bg-info">С вариантами</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Открытый</span>
                                        }
                                     </td>
                                    <td>
                                        <span class="badge bg-primary">@question.Points баллов</span>
                                     </td>
                                    <td>
                                        <a asp-action="EditQuestion" asp-route-id="@question.Id" class="btn btn-sm btn-warning">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-danger" onclick="deleteQuestion(@question.Id)">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                     </td>
                                 </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="alert alert-info mt-3">
                    <i class="fas fa-calculator"></i> Общий балл теста: <strong>@Model.Questions.Sum(q => q.Points)</strong>
                </div>
            }
            else
            {
                <div class="alert alert-info text-center">
                    <i class="fas fa-info-circle"></i> Вопросов пока нет. Добавьте первый вопрос!
                </div>
            }
        </div>
    </div>
</div>

<script>
    function deleteQuestion(id) {
        if (confirm('Вы уверены, что хотите удалить этот вопрос?')) {
            fetch(`/Lecturer/DeleteQuestion/${id}`, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                }
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert('Ошибка: ' + data.message);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Произошла ошибка при удалении вопроса');
                });
        }
    }
</script>