@model diplom.Models.Section

@{
    ViewData["Title"] = "Редактирование раздела";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="mb-0"><i class="fas fa-edit"></i> Редактирование раздела</h3>
        <a asp-action="Edit" asp-route-id="@Model.DisciplineId" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Назад к дисциплине
        </a>
    </div>
    <div class="card-body">
        <form asp-action="EditSection" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />

            <div class="mb-3">
                <label class="form-label">Название раздела *</label>
                <input type="text" name="name" class="form-control" value="@Model.Name" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Описание</label>
                <textarea name="description" class="form-control" rows="5">@Model.Description</textarea>
            </div>

            <div class="mb-3">
                <label class="form-label">Порядок отображения</label>
                <input type="number" name="order" class="form-control" value="@Model.Order" disabled />
                <small class="text-muted">Порядок меняется автоматически при добавлении/удалении разделов</small>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">Сохранить изменения</button>
                <a asp-action="Edit" asp-route-id="@Model.DisciplineId" class="btn btn-secondary">Отмена</a>
            </div>
        </form>
    </div>
</div>

<!-- Предупреждение об удалении -->
<div class="card mt-4 border-danger">
    <div class="card-header bg-danger text-white">
        <h5 class="mb-0"><i class="fas fa-exclamation-triangle"></i> Опасная зона</h5>
    </div>
    <div class="card-body">
        <p>Удаление раздела приведет к безвозвратному удалению всех материалов и тестов внутри этого раздела.</p>
        <button type="button" class="btn btn-danger" onclick="confirmDelete(@Model.Id, '@Model.Name')">
            <i class="fas fa-trash"></i> Удалить раздел
        </button>
    </div>
</div>

<script>
    function confirmDelete(id, name) {
        if (confirm(`Вы уверены, что хотите удалить раздел "${name}"?\n\nВсе материалы и тесты внутри раздела будут безвозвратно удалены!`)) {
            fetch(`/Lecturer/DeleteSection/${id}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                }
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        window.location.href = `/Lecturer/Edit/${@Model.DisciplineId}`;
                    } else {
                        alert('Ошибка: ' + data.message);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Произошла ошибка при удалении раздела');
                });
        }
    }
</script>