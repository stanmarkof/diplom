@using Microsoft.AspNetCore.Identity
@using diplom.Models
@inject UserManager<User> UserManager
@{
    ViewData["Title"] = "Главная";
    var user = await UserManager.GetUserAsync(User);
    var isStudent = User.IsInRole("Student");
    var isLecturer = User.IsInRole("Lecturer");
    var isAdmin = User.IsInRole("Admin");

    // Проверяем, есть ли у студента группа
    var hasGroup = false;
    if (isStudent && user != null)
    {
        var student = user as Student;
        hasGroup = student?.StudentGroupId.HasValue ?? false;
    }

    // Получаем отзывы из ViewBag
    var latestFeedbacks = ViewBag.LatestFeedbacks as List<Feedback> ?? new List<Feedback>();
}

<div class="fade-in">
    <!-- Главный баннер -->
    <div class="text-center mb-5">
        <h1 class="display-4 mb-3">Добро пожаловать в систему дистанционного обучения</h1>

        @if (User.Identity.IsAuthenticated)
        {
            <p class="lead">Здравствуйте, @User.Identity.Name!</p>

            @if (!hasGroup && isStudent)
            {
                <div class="alert alert-warning">
                    <i class="fas fa-info-circle"></i>
                    <strong>Внимание!</strong> Ваша группа ещё не назначена. Дождитесь назначения группы администратором.
                </div>
            }
        }
        else
        {
            <p class="lead">Удобная платформа для получения знаний онлайн</p>
            <div class="mt-4">
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg mx-2">
                    <i class="fas fa-sign-in-alt"></i> Вход
                </a>
                <a asp-controller="Account" asp-action="Register" class="btn btn-success btn-lg mx-2">
                    <i class="fas fa-user-plus"></i> Регистрация
                </a>
            </div>
        }
    </div>

 

    <!-- Карточки с возможностями -->
    <div class="row mt-4">
        @if (User.Identity.IsAuthenticated)
        {
            if (isAdmin)
            {
                <div class="col-md-4 mb-3">
                    <div class="card h-100">
                        <div class="card-body text-center">
                            <i class="fas fa-users fa-3x mb-3" style="color: var(--primary-color);"></i>
                            <h5 class="card-title">Все пользователи</h5>
                            <p class="card-text">Управление пользователями, назначение групп и ролей</p>
                            <a asp-controller="Admin" asp-action="AllUsers" class="btn btn-primary">Перейти</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card h-100">
                        <div class="card-body text-center">
                            <i class="fas fa-chalkboard-teacher fa-3x mb-3" style="color: var(--success-color);"></i>
                            <h5 class="card-title">Создать преподавателя</h5>
                            <p class="card-text">Добавление нового преподавателя в систему</p>
                            <a asp-controller="Admin" asp-action="CreateLecturer" class="btn btn-primary">Перейти</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card h-100">
                        <div class="card-body text-center">
                            <i class="fas fa-user-shield fa-3x mb-3" style="color: var(--danger-color);"></i>
                            <h5 class="card-title">Создать администратора</h5>
                            <p class="card-text">Добавление нового администратора системы</p>
                            <a asp-controller="Admin" asp-action="CreateAdmin" class="btn btn-primary">Перейти</a>
                        </div>
                    </div>
                </div>
            }

            if (isLecturer)
            {
                <div class="col-md-6 mb-3">
                    <div class="card h-100">
                        <div class="card-body text-center">
                            <i class="fas fa-book-open fa-3x mb-3" style="color: var(--primary-color);"></i>
                            <h5 class="card-title">Мои дисциплины</h5>
                            <p class="card-text">Управление дисциплинами, материалами и тестами</p>
                            <a asp-controller="Lecturer" asp-action="Index" class="btn btn-primary">Перейти</a>
                        </div>
                    </div>
                </div>
             
            }

            if (isStudent && hasGroup)
            {
                <div class="col-md-4 mb-3">
                    <div class="card h-100">
                        <div class="card-body text-center">
                            <i class="fas fa-book fa-3x mb-3" style="color: var(--primary-color);"></i>
                            <h5 class="card-title">Мои дисциплины</h5>
                            <p class="card-text">Просмотр доступных дисциплин и учебных материалов</p>
                            <a asp-controller="Student" asp-action="MyDisciplines" class="btn btn-primary">Перейти</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card h-100">
                        <div class="card-body text-center">
                            <i class="fas fa-tasks fa-3x mb-3" style="color: var(--success-color);"></i>
                            <h5 class="card-title">Мои результаты</h5>
                            <p class="card-text">Просмотр результатов тестирования</p>
                            <a asp-controller="Student" asp-action="MyResults" class="btn btn-primary">Перейти</a>
                        </div>
                    </div>
                </div>
            
            }
            else if (isStudent && !hasGroup)
            {
                <div class="col-md-12">
                    <div class="alert alert-info text-center">
                        <i class="fas fa-clock fa-2x mb-3 d-block"></i>
                        <h4>Доступ ограничен</h4>
                        <p>Ваша группа ещё не назначена. После назначения группы администратором вам станут доступны все функции системы.</p>
                    </div>
                </div>
            }
        }
        else
        {
      
        }
    </div>
</div>

   <!-- Блок с отзывами (для всех пользователей) -->
    @if (latestFeedbacks.Any())
    {
        <div class="mb-5">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>
                    <i class="fas fa-comment-dots text-primary me-2"></i>
                    Отзывы наших пользователей
                </h2>
              
            </div>

            <div class="row">
                @foreach (var feedback in latestFeedbacks)
                {
                    <div class="col-md-6 col-lg-4 mb-4">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <strong class="fs-6">
                                            <i class="fas fa-user-circle text-primary"></i>
                                            @(feedback.User?.FullName ?? "Пользователь")
                                        </strong>
                                        <br />
                                        <small class="text-muted">
                                            <i class="far fa-calendar-alt"></i>
                                            @feedback.CreatedAt.ToString("dd.MM.yyyy")
                                        </small>
                                    </div>
                                    @if (feedback.Rating.HasValue)
                                    {
                                        <div class="text-warning">
                                            @for (int i = 0; i < feedback.Rating.Value; i++)
                                            {
                                                <i class="fas fa-star"></i>
                                            }
                                            @for (int i = feedback.Rating.Value; i < 5; i++)
                                            {
                                                <i class="far fa-star"></i>
                                            }
                                        </div>
                                    }
                                </div>
                                <p class="card-text mt-2">
                                    <i class="fas fa-quote-left text-muted me-1"></i>
                                    @(feedback.Message.Length > 150 ? feedback.Message.Substring(0, 150) + "..." : feedback.Message)
                                </p>
                            </div>
                        </div>
                    </div>
                }
            </div>

           
        </div>

    }
<!-- Скрипт для открытия бота -->
<script>
    document.getElementById('openBotFromHome')?.addEventListener('click', function () {
        const botWindow = document.getElementById('botWindow');
        if (botWindow) {
            botWindow.classList.add('active');
        }
    });
</script>

<style>
    .fade-in {
        animation: fadeIn 0.5s ease-in-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        }
</style>