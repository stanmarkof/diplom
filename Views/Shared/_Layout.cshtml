        }

        localStorage.setItem('theme', theme);
        currentTheme = theme;
        
        // Обновляем отступ после смены темы (для перерисовки)
        setTimeout(updateContentMargin, 50);
    } */

    if (themeToggle) {
        applyTheme(currentTheme);
        themeToggle.addEventListener('click', function () {
            const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
            applyTheme(newTheme);
        });
    }

    // Обработка дропдауна пользователя
    document.addEventListener('DOMContentLoaded', function () {
        const userDropdown = document.querySelector('.user-dropdown');
        const dropdownToggle = document.querySelector('.user-dropdown .dropdown-toggle');

        if (dropdownToggle) {
            dropdownToggle.addEventListener('keydown', function (e) {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    this.click();
                }
            });

            dropdownToggle.addEventListener('click', function () {
                setTimeout(() => {
                    const isOpen = document.querySelector('.user-dropdown.show');
                    if (isOpen) {
                        dropdownToggle.setAttribute('aria-expanded', 'true');
                    } else {
                        dropdownToggle.setAttribute('aria-expanded', 'false');
                    }
                }, 10);
            });
        }
    });
</script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>