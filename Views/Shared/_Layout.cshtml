@using Microsoft.AspNetCore.Identity
@using diplom.Models
@inject UserManager<User> UserManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Система дистанционного обучения</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
</head>
<body>
    @{
        var user = await UserManager.GetUserAsync(User);
        var isAdmin = User.IsInRole("Admin");
        var isLecturer = User.IsInRole("Lecturer");
        var isStudent = User.IsInRole("Student");

        var hasGroup = false;
        if (isStudent && user != null)
        {
            var student = user as Student;
            hasGroup = student?.StudentGroupId.HasValue ?? false;
        }
    }

    <!-- Верхняя навигация -->
    <nav class="top-navbar">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <button class="btn btn-secondary d-md-none mobile-menu-toggle" id="mobileMenuToggle" style="background: transparent; border: none;">
                    <i class="fas fa-bars fa-lg"></i>
                </button>
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-graduation-cap"></i> Система дистанционного обучения
                </a>
            </div>

            <div class="d-flex align-items-center gap-3">
                <!-- User Dropdown -->
                <div class="user-dropdown dropdown">
                    <a href="#" class="dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" id="userDropdown">
                        <div class="user-avatar">
                            @{
                                var initial = User.Identity?.Name?.FirstOrDefault().ToString().ToUpper() ?? "U";
                            }
                            @initial
                        </div>
                        <span>@(User.Identity?.Name ?? "Аккаунт")</span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li>
                                <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                                    <i class="fas fa-user-circle"></i> Мой профиль
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">
                                    <i class="fas fa-key"></i> Сменить пароль
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item">
                                        <i class="fas fa-sign-out-alt"></i> Выйти
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li>
                                <a class="dropdown-item" asp-controller="Account" asp-action="Login">
                                    <i class="fas fa-sign-in-alt"></i> Вход
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="Account" asp-action="Register">
                                    <i class="fas fa-user-plus"></i> Регистрация
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    <!-- Вертикальная боковая навигация (только для авторизованных) -->
    @if (User.Identity.IsAuthenticated)
    {
        <div class="sidebar" id="sidebar">
            <ul class="sidebar-menu">
                @if (isAdmin)
                {
                    <div class="sidebar-divider"></div>
                    <div class="sidebar-title">Управление</div>
                    <li class="sidebar-item">
                        <a class="sidebar-link" asp-controller="Admin" asp-action="AllUsers">
                            <i class="fas fa-users"></i>
                            <span>Пользователи</span>
                        </a>
                    </li>
                    <li class="sidebar-item">
                        <a class="sidebar-link" asp-controller="Admin" asp-action="ManageGroups">
                            <i class="fas fa-layer-group"></i>
                            <span>Группы</span>
                        </a>
                    </li>
                    <li class="sidebar-item">
                        <a class="sidebar-link" asp-controller="Admin" asp-action="ManageCourses">
                            <i class="fas fa-graduation-cap"></i>
                            <span>Курсы</span>
                        </a>
                    </li>
                    <li class="sidebar-item">
                        <a class="sidebar-link" asp-controller="Admin" asp-action="ManageDisciplines">
                            <i class="fas fa-book-open"></i>
                            <span>Дисциплины</span>
                        </a>
                    </li>
                    <li class="sidebar-item">
                        <a class="sidebar-link" asp-controller="Admin" asp-action="CreateLecturer">
                            <i class="fas fa-chalkboard-teacher"></i>
                            <span>Создать преподавателя</span>
                        </a>
                    </li>
                    <li class="sidebar-item">
                        <a class="sidebar-link" asp-controller="Admin" asp-action="CreateAdmin">
                            <i class="fas fa-user-shield"></i>
                            <span>Создать администратора</span>
                        </a>

                        <div class="sidebar-divider"></div>
                        <div class="sidebar-title">Платформа</div>
                    <li class="sidebar-item">
                        <a class="sidebar-link" asp-controller="Admin" asp-action="IndexDisc">
                            <i class="fas fa-book-open"></i>
                            <span>Платформа</span>
                        </a>

                    </li>
                    </li>
                    <div class="sidebar-divider"></div>
                    <div class="sidebar-title">Настройки</div>
                    <li class="sidebar-item">
                        <a class="sidebar-link" asp-controller="Admin" asp-action="ChangeVerificationCode">
                            <i class="fas fa-key"></i>
                            <span>Код регистрации</span>
                        </a>
                    </li>
                    <div class="sidebar-divider"></div>
                    <div class="sidebar-title">Информация</div>
                    <li class="sidebar-item">
                        <a class="sidebar-link" asp-controller="Admin" asp-action="ViewFeedbacks">
                            <i class="fas fa-comment-dots"></i>
                            <span>Обратная связь</span>
                        </a>
                    </li>


                }

                @if (isLecturer)
                {
                    <div class="sidebar-divider"></div>
                    <div class="sidebar-title">Преподавателю</div>
                    <li class="sidebar-item">
                        <a class="sidebar-link" asp-controller="Lecturer" asp-action="Index">
                            <i class="fas fa-book-open"></i>
                            <span>Мои дисциплины</span>
                        </a>
                    </li>
                }

                @if (isStudent && hasGroup)
{
    <div class="sidebar-divider"></div>
    <div class="sidebar-title">Студенту</div>
    <li class="sidebar-item">
        <a class="sidebar-link" asp-controller="Student" asp-action="MyDisciplines">
            <i class="fas fa-book"></i>
            <span>Мои дисциплины</span>
        </a>
    </li>
    <li class="sidebar-item">
        <a class="sidebar-link" asp-controller="Student" asp-action="MyResults">
            <i class="fas fa-chart-line"></i>
            <span>Мои результаты</span>
        </a>
    </li>
    <li class="sidebar-item">
        <a class="sidebar-link" asp-controller="Student" asp-action="Feedback">
            <i class="fas fa-comment-dots"></i>
            <span>Обратная связь</span>
        </a>
    </li>
}
                else if (isStudent && !hasGroup)
                {
                    <div class="sidebar-divider"></div>
                    <div class="sidebar-title">Студенту</div>
                    <li class="sidebar-item">
                        <span class="sidebar-link text-muted">
                            <i class="fas fa-clock"></i>
                            <span>Ожидание группы</span>
                        </span>
                    </li>
                }

                <div class="sidebar-divider"></div>
                <div class="sidebar-title">Информация</div>
                <li class="sidebar-item">
                    <a class="sidebar-link" asp-controller="Home" asp-action="Privacy">
                        <i class="fas fa-lock"></i>
                        <span>Конфиденциальность</span>
                    </a>
                </li>
            </ul>
        </div>
    }

    <!-- Основной контент -->
    <div class="main-content @(User.Identity.IsAuthenticated ? "" : "no-sidebar")">
        <div class="container-fluid">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @RenderBody()
        </div>
    </div>

    <footer>
        <div class="container">
            &copy; @DateTime.Now.Year - Система дистанционного обучения
        </div>
    </footer>

    @{
        var botApiUrl = User.Identity?.IsAuthenticated == true ? "/api/bot/ask" : "/api/bot/guest/ask";
        var botWelcomeText = User.Identity?.IsAuthenticated == true
            ? "Привет! Я Бот-помощник."
            : "Здравствуйте! Я подскажу, как зарегистрироваться, войти в систему и куда перейти.";
    }

    <!-- Виджет AI Бота (доступен всем; для гостя — только общая справка) -->
    <div class="bot-widget" data-bot-api="@botApiUrl">
        <button id="botToggleBtn" class="bot-toggle-btn" title="Задать вопрос AI помощнику">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 4c1.1 0 2 .9 2 2s-.9 2-2 2-2-.9-2-2 .9-2 2-2zm0 13c-2.33 0-4.31-1.46-5.11-3.5h10.22c-.8 2.04-2.78 3.5-5.11 3.5z" fill="currentColor" />
            </svg>
        </button>

        <div id="botWindow" class="bot-window">
            <div class="bot-container">
                <div class="bot-header">
                    <div class="bot-header-info">
                        
                        <div>
                            <h5>Бот Помощник</h5>
                            <small>@(User.Identity?.IsAuthenticated == true ? "С учётом вашей роли" : "Справка для гостя")</small>
                        </div>
                    </div>
                    
                        <div class="bot-mode-switch">
                            <label class="switch-label">
                                <span class="mode-text mode-ai">Нейросеть</span>
                                <div class="switch-track" id="aiModeSwitch">
                                    <div class="switch-thumb"></div>
                                </div>
                                <span class="mode-text mode-emb">База знаний</span>
                            </label>
                        </div>
                    
                    <button id="botCloseBtn" class="bot-close-btn">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M18 6L6 18M6 6l12 12" />
                        </svg>
                    </button>
                </div>
                <div id="botMessages" class="bot-messages">
                    <div class="bot-message bot">
                        <div class="message-bubble">
                            @botWelcomeText
                        </div>
                        <div class="message-time">Сейчас</div>
                    </div>
                </div>
                <div class="bot-input-container">
                    <input type="text" id="botInput" class="bot-input" placeholder="Напишите вопрос..." />
                    <button id="botSendBtn" class="bot-send-btn">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z" />
                        </svg>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Виджеты только для авторизованных -->
    @if (User.Identity.IsAuthenticated)
    {
        

        <!-- Виджет чата (мессенджер) - только для авторизованных -->
        @if (User.Identity.IsAuthenticated)
        {
            <div class="chat-widget">
                <button id="chatToggleBtn" class="chat-toggle-btn" title="Открыть чат">
                    <span id="chatUnreadBadge" class="unread-badge" style="display: none;">0</span>
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M20 2H4C2.9 2 2 2.9 2 4V22L6 18H20C21.1 18 22 17.1 22 16V4C22 2.9 21.1 2 20 2Z" fill="currentColor" />
                    </svg>
                </button>
            </div>

            <!-- Окно чата -->
            <div id="chatWindow" class="chat-window">
                <div class="bot-header">
                    <div class="bot-header-info">
                        <div class="bot-avatar">💬</div>
                        <div>
                            <h5 id="chatWindowTitle">Сообщения</h5>
                            <small>Общение с пользователями</small>
                        </div>
                    </div>
                    <button id="chatCloseBtn" class="bot-close-btn">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M18 6L6 18M6 6l12 12" />
                        </svg>
                    </button>
                </div>

                <!-- Список диалогов (главный экран) -->
                <div id="chatDialogsView" style="display: flex; flex-direction: column; height: 100%;">
                    <div style="padding: 0.75rem; border-bottom: 1px solid var(--border-color);">
                        <button id="newChatBtn" class="btn btn-sm btn-primary w-100">
                            <i class="fas fa-plus"></i> Новый чат
                        </button>
                    </div>
                    <div id="chatDialogsList" class="chat-dialogs-list-widget">
                        <!-- Диалоги загрузятся через JS -->
                        <div class="text-center text-muted p-3">Загрузка...</div>
                    </div>
                </div>

                <!-- Новый чат - выбор пользователя -->
                <div id="chatNewChatView" style="display: none; flex-direction: column; height: 100%;">
                    <div style="padding: 0.75rem; border-bottom: 1px solid var(--border-color);">
                        <button id="chatBackToDialogs" class="chat-back-btn">
                            <i class="fas fa-arrow-left"></i>
                        </button>
                        <span>Выберите пользователя</span>
                    </div>
                    <div id="chatUsersList" class="chat-users-list">
                        <!-- Пользователи загрузятся через JS -->
                        <div class="text-center text-muted p-3">Загрузка...</div>
                    </div>
                </div>

                <!-- Диалог с сообщениями -->
                <div id="chatMessagesView" style="display: none; flex-direction: column; height: 100%;">
                    <div style="padding: 0.75rem; border-bottom: 1px solid var(--border-color); display: flex; align-items: center; gap: 0.5rem;">
                        <button id="chatBackToDialogsFromMessages" class="chat-back-btn">
                            <i class="fas fa-arrow-left"></i>
                        </button>
                        <div>
                            <strong id="chatCurrentUserName"></strong>
                            <br />
                            <small class="text-muted" id="chatCurrentUserRole"></small>
                        </div>
                    </div>
                    <div id="chatMessagesList" class="chat-messages-container-widget">
                        <!-- Сообщения загрузятся через JS -->
                    </div>
                    <div class="chat-input-area-widget">
                        <input type="text" id="chatMessageInput" class="chat-input-widget" placeholder="Введите сообщение..." />
                        <button id="chatSendMsgBtn" class="chat-send-btn-widget">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                                <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z" />
                            </svg>
                        </button>
                    </div>
                </div>
            </div>
        }
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Мобильное меню
        const menuToggle = document.getElementById('mobileMenuToggle');
        const sidebar = document.getElementById('sidebar');
        const mainContent = document.querySelector('.main-content');
        const footer = document.querySelector('footer');

        function updateContentMargin() {
            if (!sidebar) return;
            const isMobileOpen = sidebar.classList.contains('mobile-open');
            const isHovered = sidebar.matches(':hover') && window.innerWidth > 768;

            if (window.innerWidth > 768) {
                const marginWidth = isHovered ? 280 : 70;
                if (mainContent) mainContent.style.marginLeft = marginWidth + 'px';
                if (footer) footer.style.marginLeft = marginWidth + 'px';
            } else {
                const marginWidth = isMobileOpen ? 280 : 0;
                if (mainContent) mainContent.style.marginLeft = marginWidth + 'px';
                if (footer) footer.style.marginLeft = marginWidth + 'px';
            }
        }

        if (sidebar) {
            sidebar.addEventListener('mouseenter', () => window.innerWidth > 768 && updateContentMargin());
            sidebar.addEventListener('mouseleave', () => window.innerWidth > 768 && updateContentMargin());

            const observer = new MutationObserver(() => updateContentMargin());
            observer.observe(sidebar, { attributes: true });
        }

        if (menuToggle) {
            menuToggle.addEventListener('click', () => {
                sidebar.classList.toggle('mobile-open');
                updateContentMargin();
            });
        }

        document.querySelectorAll('.sidebar-link').forEach(link => {
            link.addEventListener('click', () => {
                if (window.innerWidth < 768) {
                    sidebar.classList.remove('mobile-open');
                    updateContentMargin();
                }
            });
        });

        updateContentMargin();

        // Бот-виджет с переключателем режимов
        const botToggleBtn = document.getElementById('botToggleBtn');
        const botCloseBtn = document.getElementById('botCloseBtn');
        const botWindow = document.getElementById('botWindow');
        const botMessages = document.getElementById('botMessages');
        const botInput = document.getElementById('botInput');
        const botSendBtn = document.getElementById('botSendBtn');
        const aiModeSwitch = document.getElementById('aiModeSwitch');
        let isBotTyping = false;
        let useAI = true; // По умолчанию используем нейросеть
        const botWidgetEl = document.querySelector('.bot-widget[data-bot-api]');
        const botAskUrl = botWidgetEl ? botWidgetEl.getAttribute('data-bot-api') : '/api/bot/guest/ask';

        // Загружаем сохранённый режим
        const savedMode = localStorage.getItem('botUseAI');
        if (savedMode !== null) {
            useAI = savedMode === 'true';
            if (aiModeSwitch) {
                if (!useAI) {
                    aiModeSwitch.classList.add('emb-mode');
                } else {
                    aiModeSwitch.classList.remove('emb-mode');
                }
            }
        }

        // Обработчик переключателя режимов
        if (aiModeSwitch) {
            aiModeSwitch.addEventListener('click', () => {
                useAI = !useAI;
                if (useAI) {
                    aiModeSwitch.classList.remove('emb-mode');
                    addSystemMessage('🧠 Режим нейросети включен. Ответы будут генерироваться с помощью AI.');
                } else {
                    aiModeSwitch.classList.add('emb-mode');
                    addSystemMessage('📚 Режим базы знаний включен. Будут использоваться только точные совпадения из базы знаний.');
                }
                localStorage.setItem('botUseAI', useAI);
            });
        }

        function addSystemMessage(message) {
            const messageDiv = document.createElement('div');
            messageDiv.className = 'bot-message system';
            const time = new Date().toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' });
            messageDiv.innerHTML = `
                <div class="message-bubble system-bubble">
                    <i class="fas fa-info-circle"></i> ${escapeHtml(message)}
                </div>
                <div class="message-time">${time}</div>
            `;
            botMessages.appendChild(messageDiv);
            botMessages.scrollTop = botMessages.scrollHeight;
        }

        if (botToggleBtn) {
            botToggleBtn.addEventListener('click', () => botWindow.classList.add('active'));
            botCloseBtn.addEventListener('click', () => botWindow.classList.remove('active'));
        }

        function addBotMessage(message, isUser = false) {
            const messageDiv = document.createElement('div');
            messageDiv.className = `bot-message ${isUser ? 'user' : 'bot'}`;
            const time = new Date().toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' });
            messageDiv.innerHTML = `
                <div class="message-bubble">${escapeHtml(message).replace(/\n/g, '<br>')}</div>
                <div class="message-time">${time}</div>
            `;
            botMessages.appendChild(messageDiv);
            botMessages.scrollTop = botMessages.scrollHeight;
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        async function sendBotMessage() {
            const message = botInput.value.trim();
            if (!message || isBotTyping) return;
            botInput.value = '';
            addBotMessage(message, true);
            isBotTyping = true;

            // Показываем индикатор печати
            const typingIndicator = document.createElement('div');
            typingIndicator.className = 'bot-message bot typing';
            typingIndicator.innerHTML = `
                <div class="message-bubble">
                    <span class="typing-dots">...</span>
                </div>
            `;
            botMessages.appendChild(typingIndicator);
            botMessages.scrollTop = botMessages.scrollHeight;

            try {
                const response = await fetch(botAskUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify({
                        query: message,
                        useAI: useAI // Отправляем режим на сервер
                    })
                });

                // Удаляем индикатор печати
                typingIndicator.remove();

                if (response.ok) {
                    const data = await response.json();
                    addBotMessage(data.answer, false);
                } else {
                    addBotMessage('Извините, произошла ошибка. Попробуйте позже.', false);
                }
            } catch (error) {
                console.error('Bot error:', error);
                typingIndicator.remove();
                addBotMessage('Не удалось подключиться к боту.', false);
            } finally {
                isBotTyping = false;
            }
        }

        if (botSendBtn) botSendBtn.addEventListener('click', sendBotMessage);
        if (botInput) botInput.addEventListener('keypress', (e) => e.key === 'Enter' && sendBotMessage());

            // ==================== ВИДЖЕТ ЧАТА (МЕССЕНДЖЕР) ====================
    const chatToggleBtn = document.getElementById('chatToggleBtn');
    const chatWindow = document.getElementById('chatWindow');
    const chatCloseBtn = document.getElementById('chatCloseBtn');
    const chatDialogsView = document.getElementById('chatDialogsView');
    const chatNewChatView = document.getElementById('chatNewChatView');
    const chatMessagesView = document.getElementById('chatMessagesView');
    const chatDialogsList = document.getElementById('chatDialogsList');
    const chatUsersList = document.getElementById('chatUsersList');
    const chatMessagesList = document.getElementById('chatMessagesList');
    const chatMessageInput = document.getElementById('chatMessageInput');
    const chatSendMsgBtn = document.getElementById('chatSendMsgBtn');
    const newChatBtn = document.getElementById('newChatBtn');
    const chatBackToDialogs = document.getElementById('chatBackToDialogs');
    const chatBackToDialogsFromMessages = document.getElementById('chatBackToDialogsFromMessages');
    const chatCurrentUserName = document.getElementById('chatCurrentUserName');
    const chatCurrentUserRole = document.getElementById('chatCurrentUserRole');
    const chatWindowTitle = document.getElementById('chatWindowTitle');
    const chatUnreadBadge = document.getElementById('chatUnreadBadge');
    
    let currentChatOtherUserId = null;
    let chatPollingInterval = null;
    let allDialogs = [];
    
    // Открыть/закрыть виджет чата
    if (chatToggleBtn) {
        chatToggleBtn.addEventListener('click', () => {
            chatWindow.classList.toggle('active');
            if (chatWindow.classList.contains('active')) {
                loadDialogs();
            }
        });
    }
    if (chatCloseBtn) chatCloseBtn.addEventListener('click', () => chatWindow.classList.remove('active'));
    
    // Загрузка диалогов
    async function loadDialogs() {
        try {
            const response = await fetch('/Chat/GetDialogs');
            const data = await response.json();
            if (data.success) {
                allDialogs = data.dialogs;
                renderDialogs(data.dialogs);
                
                // Обновляем счетчик непрочитанных
                const unreadCount = data.dialogs.reduce((sum, d) => sum + d.unreadCount, 0);
                if (unreadCount > 0) {
                    chatUnreadBadge.style.display = 'flex';
                    chatUnreadBadge.textContent = unreadCount > 9 ? '9+' : unreadCount;
                } else {
                    chatUnreadBadge.style.display = 'none';
                }
            }
        } catch (error) {
            console.error('Error loading dialogs:', error);
        }
    }
    
    function renderDialogs(dialogs) {
        if (!chatDialogsList) return;
        
        if (dialogs.length === 0) {
            chatDialogsList.innerHTML = '<div class="text-center text-muted p-3">Нет диалогов</div>';
            return;
        }
        
        chatDialogsList.innerHTML = dialogs.map(dialog => `
            <div class="chat-dialog-item-widget" data-user-id="${dialog.otherUserId}" data-user-name="${escapeHtml(dialog.otherUserName)}" data-user-role="${dialog.userRole}">
                <div class="chat-dialog-avatar-widget">
                    <div class="avatar-circle-widget" style="background: ${getRoleColor(dialog.userRole)}">
                        ${dialog.otherUserName.charAt(0).toUpperCase()}
                    </div>
                </div>
                <div class="chat-dialog-info-widget">
                    <div class="chat-dialog-name-widget">${escapeHtml(dialog.otherUserName)}</div>
                    <div class="chat-dialog-lastmsg-widget">${escapeHtml(dialog.lastMessage || 'Нет сообщений')}</div>
                </div>
                ${dialog.unreadCount > 0 ? `<span class="badge bg-danger rounded-pill" style="font-size: 10px;">${dialog.unreadCount}</span>` : ''}
            </div>
        `).join('');
        
        // Добавляем обработчики кликов
        document.querySelectorAll('.chat-dialog-item-widget').forEach(el => {
            el.addEventListener('click', () => {
                const userId = parseInt(el.dataset.userId);
                const userName = el.dataset.userName;
                const userRole = el.dataset.userRole;
                openChatDialog(userId, userName, userRole);
            });
        });
    }
    
    // Загрузка пользователей для нового чата
    // Загрузка пользователей для нового чата
async function loadUsers() {
    try {
        const response = await fetch('/Chat/GetUsers');
        const data = await response.json();
        if (data.success && chatUsersList) {
            let html = '';
                    for (let i = 0; i < data.users.length; i++) {
                        const user = data.users[i];
                        html += '<div class="chat-user-item" data-user-id="' + user.id + '" data-user-name="' + escapeHtml(user.fullName) + '" data-user-role="' + user.role + '">';
                        html += '<div><strong>' + escapeHtml(user.fullName) + '</strong><br />';
                        html += '<small class="text-muted">' + user.userName + '</small></div>';
                        html += '<span class="badge bg-secondary">' + user.role + '</span>';
                        html += '</div>';
                    }
                    chatUsersList.innerHTML = html;
                  
            
            document.querySelectorAll('.chat-user-item').forEach(function(el) {
                el.addEventListener('click', function() {
                    const userId = parseInt(el.dataset.userId);
                    const userName = el.dataset.userName;
                    const userRole = el.dataset.userRole;
                    startNewChat(userId, userName, userRole);
                });
            });
        }
    } catch (error) {
        console.error('Error loading users:', error);
    }
}
    
    function startNewChat(userId, userName, userRole) {
        currentChatOtherUserId = userId;
        chatCurrentUserName.textContent = userName;
        chatCurrentUserRole.textContent = userRole;
        
        // Переключаемся на вид сообщений
        chatDialogsView.style.display = 'none';
        chatNewChatView.style.display = 'none';
        chatMessagesView.style.display = 'flex';
        chatWindowTitle.textContent = userName;
        
        loadMessages(userId);
    }
    
    function openChatDialog(userId, userName, userRole) {
        currentChatOtherUserId = userId;
        chatCurrentUserName.textContent = userName;
        chatCurrentUserRole.textContent = userRole;
        
        chatDialogsView.style.display = 'none';
        chatNewChatView.style.display = 'none';
        chatMessagesView.style.display = 'flex';
        chatWindowTitle.textContent = userName;
        
        loadMessages(userId);
    }
    
    async function loadMessages(userId) {
        try {
            const response = await fetch(`/Chat/GetMessages?userId=${userId}`);
            const data = await response.json();
            if (data.success && chatMessagesList) {
                renderMessages(data.messages);
                startChatPolling(userId);
            }
        } catch (error) {
            console.error('Error loading messages:', error);
        }
    }
    
    function renderMessages(messages) {
        if (!chatMessagesList) return;
        
        if (messages.length === 0) {
            chatMessagesList.innerHTML = '<div class="text-center text-muted p-3">Нет сообщений. Напишите что-нибудь...</div>';
            return;
        }
        
        chatMessagesList.innerHTML = messages.map(msg => `
            <div class="chat-message-widget ${msg.isMine ? 'mine' : 'other'}">
                <div class="chat-message-bubble-widget">${escapeHtml(msg.message)}</div>
                <div class="chat-message-time-widget ${msg.isMine ? 'text-end' : ''}">
                    ${new Date(msg.sentAt).toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' })}
                </div>
            </div>
        `).join('');
        
        // Прокрутка вниз
        chatMessagesList.scrollTop = chatMessagesList.scrollHeight;
    }

        // Отправка сообщения
        async function sendChatMessage() {
            const message = chatMessageInput ? chatMessageInput.value.trim() : '';
            if (!message || !currentChatOtherUserId) return;
            if (chatMessageInput) chatMessageInput.value = '';

            try {
                const response = await fetch('/Chat/SendMessage', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    },
                    body: JSON.stringify({
                        recipientId: currentChatOtherUserId,
                        message: message
                    })
                });
                const data = await response.json();
                if (data.success) {
                    // Добавляем сообщение в список сразу
                    if (chatMessagesList) {
                        const msgHtml = '<div class="chat-message-widget mine">' +
                            '<div class="chat-message-bubble-widget">' + escapeHtml(message) + '</div>' +
                            '<div class="chat-message-time-widget text-end">' + new Date().toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' }) + '</div>' +
                            '</div>';
                        chatMessagesList.insertAdjacentHTML('beforeend', msgHtml);
                        chatMessagesList.scrollTop = chatMessagesList.scrollHeight;
                    }
                    loadDialogs(); // Обновляем список диалогов
                } else {
                    console.error('Send error:', data.error);
                }
            } catch (error) {
                console.error('Error sending message:', error);
            }
        }

        function startChatPolling(userId) {
        if (chatPollingInterval) clearInterval(chatPollingInterval);
        chatPollingInterval = setInterval(() => {
            if (currentChatOtherUserId === userId && chatMessagesView.style.display === 'flex') {
                loadMessages(userId);
            }
            loadDialogs(); // Обновляем счетчики
        }, 3000);
    }
    
    function getRoleColor(role) {
        const colors = { 'Admin': '#ef4444', 'Lecturer': '#22c55e', 'Student': '#3b82f6' };
        return colors[role] || '#6366f1';
    }
    
    // Обработчики навигации
    if (newChatBtn) {
        newChatBtn.addEventListener('click', () => {
            chatDialogsView.style.display = 'none';
            chatNewChatView.style.display = 'flex';
            chatMessagesView.style.display = 'none';
            loadUsers();
        });
    }
    
    if (chatBackToDialogs) {
        chatBackToDialogs.addEventListener('click', () => {
            chatDialogsView.style.display = 'flex';
            chatNewChatView.style.display = 'none';
            chatMessagesView.style.display = 'none';
            chatWindowTitle.textContent = 'Сообщения';
            loadDialogs();
        });
    }

        // Кнопка назад из диалога к списку чатов
        if (chatBackToDialogsFromMessages) {
            chatBackToDialogsFromMessages.addEventListener('click', function () {
                // Показываем список диалогов
                if (chatDialogsView) chatDialogsView.style.display = 'flex';
                if (chatNewChatView) chatNewChatView.style.display = 'none';
                if (chatMessagesView) chatMessagesView.style.display = 'none';
                if (chatWindowTitle) chatWindowTitle.textContent = 'Сообщения';

                // Очищаем текущий диалог
                currentChatOtherUserId = null;
                if (chatPollingInterval) clearInterval(chatPollingInterval);

                // Перезагружаем список диалогов
                loadDialogs();
            });
        }

        if (chatSendMsgBtn) chatSendMsgBtn.addEventListener('click', sendChatMessage);
    if (chatMessageInput) chatMessageInput.addEventListener('keypress', (e) => e.key === 'Enter' && sendChatMessage());

        // Обработка дропдауна пользователя
        document.addEventListener('DOMContentLoaded', () => {
            const dropdownToggle = document.querySelector('.user-dropdown .dropdown-toggle');
            if (dropdownToggle) {
                dropdownToggle.addEventListener('click', function () {
                    setTimeout(() => {
                        const isOpen = document.querySelector('.user-dropdown.show');
                        this.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
                    }, 10);
                });
            }
        });



    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>