@using Microsoft.AspNetCore.Identity
@using diplom.Models
@inject UserManager<User> UserManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Система дистанционного обучения</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
</head>
<body>
    @{
        var user = await UserManager.GetUserAsync(User);
        var isAdmin = User.IsInRole("Admin");
        var isLecturer = User.IsInRole("Lecturer");
        var isStudent = User.IsInRole("Student");

        var hasGroup = false;
        if (isStudent && user != null)
        {
            var student = user as Student;
            hasGroup = student?.StudentGroupId.HasValue ?? false;
        }
    }

    <!-- Верхняя навигация -->
    <nav class="top-navbar">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <button class="btn btn-secondary d-md-none mobile-menu-toggle" id="mobileMenuToggle" style="background: transparent; border: none;">
                    <i class="fas fa-bars fa-lg"></i>
                </button>
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-graduation-cap"></i> Система дистанционного обучения
                </a>
            </div>

            <div class="d-flex align-items-center gap-3">
                <!-- Переключатель темы -->
                <div class="theme-toggle">
                    <button id="themeToggle" class="btn btn-secondary" style="background: transparent; border: 1px solid var(--border-color); border-radius: 2rem; padding: 0.5rem 1rem;">
                        <i id="themeIcon" class="fas fa-moon"></i>
                        <span id="themeText" class="ms-2 d-none d-sm-inline">Тёмная</span>
                    </button>
                </div>

                <!-- User Dropdown -->
                <div class="user-dropdown dropdown">
                    <a href="#" class="dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" id="userDropdown">
                        <div class="user-avatar">
                            @{
                                var initial = User.Identity?.Name?.FirstOrDefault().ToString().ToUpper() ?? "U";
                            }
                            @initial
                        </div>
                        <span>@(User.Identity?.Name ?? "Аккаунт")</span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li>
                                <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                                    <i class="fas fa-user-circle"></i> Мой профиль
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">
                                    <i class="fas fa-key"></i> Сменить пароль
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item">
                                        <i class="fas fa-sign-out-alt"></i> Выйти
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li>
                                <a class="dropdown-item" asp-controller="Account" asp-action="Login">
                                    <i class="fas fa-sign-in-alt"></i> Вход
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="Account" asp-action="Register">
                                    <i class="fas fa-user-plus"></i> Регистрация
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    <!-- Вертикальная боковая навигация (только для авторизованных) -->
    @if (User.Identity.IsAuthenticated)
    {
        <div class="sidebar" id="sidebar">
            <ul class="sidebar-menu">


                @if (isAdmin)
                {
                    <div class="sidebar-divider"></div>
                    <div class="sidebar-title">Управление</div>
                    <li class="sidebar-item">
                        <a class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "AllUsers" ? "active" : "")"
                           asp-controller="Admin" asp-action="AllUsers">
                            <i class="fas fa-users"></i>
                            <span>Пользователи</span>
                        </a>
                    </li>
                    <li class="sidebar-item">
                        <a class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "ManageGroups" ? "active" : "")"
                           asp-controller="Admin" asp-action="ManageGroups">
                            <i class="fas fa-layer-group"></i>
                            <span>Группы</span>
                        </a>
                    </li>
                    <li class="sidebar-item">
                        <a class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "ManageCourses" ? "active" : "")"
                           asp-controller="Admin" asp-action="ManageCourses">
                            <i class="fas fa-graduation-cap"></i>
                            <span>Курсы</span>
                        </a>
                    </li>
                    <li class="sidebar-item">
                        <a class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "ManageDisciplines" ? "active" : "")"
                           asp-controller="Admin" asp-action="ManageDisciplines">
                            <i class="fas fa-book-open"></i>
                            <span>Дисциплины</span>
                        </a>
                    </li>
                    <li class="sidebar-item">
                        <a class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "CreateLecturer" ? "active" : "")"
                           asp-controller="Admin" asp-action="CreateLecturer">
                            <i class="fas fa-chalkboard-teacher"></i>
                            <span>Создать преподавателя</span>
                        </a>
                    </li>
                    <li class="sidebar-item">
                        <a class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "CreateAdmin" ? "active" : "")"
                           asp-controller="Admin" asp-action="CreateAdmin">
                            <i class="fas fa-user-shield"></i>
                            <span>Создать администратора</span>
                        </a>
                    </li>
                    <div class="sidebar-divider"></div>
                    <div class="sidebar-title">Настройки</div>
                    <li class="sidebar-item">
                        <a class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "ChangeVerificationCode" ? "active" : "")"
                           asp-controller="Admin" asp-action="ChangeVerificationCode">
                            <i class="fas fa-key"></i>
                            <span>Код регистрации</span>
                        </a>
                    </li>
                    <div class="sidebar-divider"></div>
                    <div class="sidebar-title">Информация</div>
                    <li class="sidebar-item">
                        <a class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "ViewFeedbacks" ? "active" : "")"
                           asp-controller="Admin" asp-action="ViewFeedbacks">
                            <i class="fas fa-comment-dots"></i>
                            <span>Обратная связь</span>
                        </a>
                    </li>
                }

                @if (isLecturer)
                {
                    <div class="sidebar-divider"></div>
                    <div class="sidebar-title">Преподавателю</div>
                    <li class="sidebar-item">
                        <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Lecturer" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                           asp-controller="Lecturer" asp-action="Index">
                            <i class="fas fa-book-open"></i>
                            <span>Мои дисциплины</span>
                        </a>
                    </li>
                }

                @if (isStudent && hasGroup)
                {
                    <div class="sidebar-divider"></div>
                    <div class="sidebar-title">Студенту</div>
                    <li class="sidebar-item">
                        <a class="sidebar-link" asp-controller="Student" asp-action="MyDisciplines">
                            <i class="fas fa-book"></i>
                            <span>Мои дисциплины</span>
                        </a>
                    </li>
                    <li class="sidebar-item">
                        <a class="sidebar-link" asp-controller="Student" asp-action="MyTests">
                            <i class="fas fa-tasks"></i>
                            <span>Мои тесты</span>
                        </a>
                    </li>
                    <li class="sidebar-item">
                        <a class="sidebar-link" asp-controller="Chat" asp-action="Index">
                            <i class="fas fa-comments"></i>
                            <span>Чат</span>
                        </a>
                    </li>
                    <li class="sidebar-item">
                        <a class="sidebar-link" asp-controller="Bot" asp-action="Index">
                            <i class="fas fa-robot"></i>
                            <span>AI Помощник</span>
                        </a>
                    </li>
                }
                else if (isStudent && !hasGroup)
                {
                    <div class="sidebar-divider"></div>
                    <div class="sidebar-title">Студенту</div>
                    <li class="sidebar-item">
                        <a class="sidebar-link text-muted" href="#" style="cursor: default;" onclick="return false;">
                            <i class="fas fa-clock"></i>
                            <span>Ожидание группы</span>
                        </a>
                    </li>
                }

                <div class="sidebar-divider"></div>
                <div class="sidebar-title">Информация</div>
                <li class="sidebar-item">
                    <a class="sidebar-link" asp-controller="Home" asp-action="Privacy">
                        <i class="fas fa-lock"></i>
                        <span>Конфиденциальность</span>
                    </a>
                </li>
            </ul>
        </div>
    }

    <!-- Основной контент -->
    <div class="main-content @(User.Identity.IsAuthenticated ? "" : "no-sidebar")">
        <div class="container-fluid">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @RenderBody()
        </div>
    </div>

    <footer>
        <div class="container">
            &copy; @DateTime.Now.Year - Система дистанционного обучения
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
    // Мобильное меню
    const menuToggle = document.getElementById('mobileMenuToggle');
    const sidebar = document.getElementById('sidebar');
    const mainContent = document.querySelector('.main-content');
    const footer = document.querySelector('footer');

    // Функция для обновления отступа контента
    function updateContentMargin() {
        if (!sidebar) return;
        
        // Проверяем, находится ли меню в состоянии мобильного открытия
        const isMobileOpen = sidebar.classList.contains('mobile-open');
        
        // Проверяем, наведена ли мышь на меню (только для десктопа)
        const isHovered = sidebar.matches(':hover') && window.innerWidth > 768;
        
        if (window.innerWidth > 768) {
            // Десктоп: отступ зависит от состояния наведения
            const marginWidth = isHovered ? 280 : 70;
            if (mainContent) mainContent.style.marginLeft = marginWidth + 'px';
            if (footer) footer.style.marginLeft = marginWidth + 'px';
        } else {
            // Мобилка: отступ только если меню открыто
            const marginWidth = isMobileOpen ? 280 : 0;
            if (mainContent) mainContent.style.marginLeft = marginWidth + 'px';
            if (footer) footer.style.marginLeft = marginWidth + 'px';
        }
    }

    if (sidebar) {
        // Обработчики для наведения мыши
        sidebar.addEventListener('mouseenter', function() {
            if (window.innerWidth > 768) {
                updateContentMargin();
            }
        });
        
        sidebar.addEventListener('mouseleave', function() {
            if (window.innerWidth > 768) {
                updateContentMargin();
            }
        });
        
        // Следим за изменениями класса mobile-open
        const observer = new MutationObserver(function(mutations) {
            mutations.forEach(function(mutation) {
                if (mutation.attributeName === 'class') {
                    updateContentMargin();
                }
            });
        });
        
        observer.observe(sidebar, { attributes: true });
    }

    if (menuToggle) {
        menuToggle.addEventListener('click', function () {
            sidebar.classList.toggle('mobile-open');
            updateContentMargin();
        });
    }

    // Закрытие мобильного меню при клике на ссылку
    const sidebarLinks = document.querySelectorAll('.sidebar-link');
    sidebarLinks.forEach(link => {
        link.addEventListener('click', () => {
            if (window.innerWidth < 768) {
                sidebar.classList.remove('mobile-open');
                updateContentMargin();
            }
        });
    });
    
    // Предотвращение клика для неактивных ссылок
    const inactiveLinks = document.querySelectorAll('.sidebar-link.text-muted');
    inactiveLinks.forEach(link => {
        link.addEventListener('click', (e) => {
            e.preventDefault();
            return false;
        });
    });
    
    // Обновляем отступ при загрузке и изменении размера окна
    window.addEventListener('resize', function() {
        updateContentMargin();
    });
    
    // Инициализация
    updateContentMargin();

    // ==================== ТЕМНАЯ / СВЕТЛАЯ ТЕМА ====================
  /*  const themeToggle = document.getElementById('themeToggle');
    const themeIcon = document.getElementById('themeIcon');
    const themeText = document.getElementById('themeText');

