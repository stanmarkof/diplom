            root.style.setProperty('--bg-sidebar', '#f8f9fa');
            root.style.setProperty('--text-primary', '#212529');
            root.style.setProperty('--text-secondary', '#6c757d');
            root.style.setProperty('--border-color', '#dee2e6');
            root.style.setProperty('--accent-primary', '#667eea');
            root.style.setProperty('--accent-secondary', '#764ba2');
            root.style.setProperty('--accent-success', '#48bb78');
            root.style.setProperty('--accent-danger', '#f56565');
            root.style.setProperty('--accent-warning', '#ed8936');
            root.style.setProperty('--accent-info', '#4299e1');

            themeIcon.className = 'fas fa-sun';
            themeText.textContent = 'Светлая';
        } else {
            root.style.setProperty('--bg-primary', '#0f0f1a');
            root.style.setProperty('--bg-secondary', '#1a1a2e');
            root.style.setProperty('--bg-card', '#16213e');
            root.style.setProperty('--bg-sidebar', '#0a0a15');
            root.style.setProperty('--text-primary', '#e0e0e0');
            root.style.setProperty('--text-secondary', '#a0a0a0');
            root.style.setProperty('--border-color', '#2d2d4a');
            root.style.setProperty('--accent-primary', '#667eea');
            root.style.setProperty('--accent-secondary', '#764ba2');
            root.style.setProperty('--accent-success', '#48bb78');
            root.style.setProperty('--accent-danger', '#f56565');
            root.style.setProperty('--accent-warning', '#ed8936');
            root.style.setProperty('--accent-info', '#4299e1');

