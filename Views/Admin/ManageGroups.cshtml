@model List<diplom.Models.StudentGroup>

@{
    ViewData["Title"] = "Управление группами";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="mb-0"><i class="fas fa-layer-group"></i> Управление группами</h3>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createModal">
            <i class="fas fa-plus"></i> Создать группу
        </button>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Название группы</th>
                        <th>Курс</th>
                        <th>Год поступления</th>
                        <th>Кол-во студентов</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var group in Model)
                    {
                        <tr>
                            <td>@group.Id</td>
                            <td>@group.Name</td>
                            <td>@group.Course?.Name</td>
                            <td>@group.YearOfAdmission</td>
                            <td>@group.Students?.Count</td>
                            <td>
                                <button type="button" class="btn btn-sm btn-info" data-bs-toggle="modal" data-bs-target="#editModal@(group.Id)">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal@(group.Id)">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>

                        <!-- Модальное окно редактирования -->
                        <div class="modal fade" id="editModal@(group.Id)" tabindex="-1">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <form asp-action="EditGroup" method="post">
                                        <input type="hidden" name="Id" value="@group.Id" />
                                        <div class="modal-header bg-info text-white">
                                            <h5 class="modal-title">Редактирование группы</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <div class="modal-body">
                                            <div class="mb-3">
                                                <label class="form-label">Название группы</label>
                                                <input type="text" name="Name" class="form-control" value="@group.Name" required />
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">Год поступления</label>
                                                <input type="number" name="YearOfAdmission" class="form-control" value="@group.YearOfAdmission" required />
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">Курс</label>
                                                <select name="CourseId" class="form-select" asp-items="ViewBag.Courses"></select>
                                            </div>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                                            <button type="submit" class="btn btn-info">Сохранить</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>

                        <!-- Модальное окно удаления -->
                        <div class="modal fade" id="deleteModal@(group.Id)" tabindex="-1">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <form asp-action="DeleteGroup" method="post">
                                        <input type="hidden" name="id" value="@group.Id" />
                                        <div class="modal-header bg-danger text-white">
                                            <h5 class="modal-title">Удаление группы</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <div class="modal-body">
                                            <p>Вы уверены, что хотите удалить группу <strong>@group.Name</strong>?</p>
                                            <div class="alert alert-warning">
                                                <i class="fas fa-exclamation-triangle"></i> Студенты останутся без группы!
                                            </div>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                                            <button type="submit" class="btn btn-danger">Удалить</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Модальное окно создания -->
<div class="modal fade" id="createModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="CreateGroup" method="post">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Создание группы</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Название группы</label>
                        <input type="text" name="Name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Год поступления</label>
                        <input type="number" name="YearOfAdmission" class="form-control" value="@DateTime.Now.Year" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Курс</label>
                        <select name="CourseId" class="form-select" asp-items="ViewBag.Courses" required>
                            <option value="">-- Выберите курс --</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                    <button type="submit" class="btn btn-primary">Создать</button>
                </div>
            </form>
        </div>
    </div>
</div>