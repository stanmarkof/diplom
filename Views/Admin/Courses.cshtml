@model IEnumerable<diplom.Models.Course>

@{
    ViewData["Title"] = "Управление курсами";
}

<div class="container fade-in">
    <div class="card">
        <div class="card-header">
            <h3 class="mb-0"><i class="fas fa-graduation-cap"></i> Управление курсами</h3>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <a asp-action="CreateCourse" class="btn btn-primary">
                    <i class="fas fa-plus"></i> Создать курс
                </a>
            </div>

            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Код</th>
                            <th>Название курса</th>
                            <th>Срок обучения</th>
                            <th>Групп</th>
                            <th>Дисциплин</th>
                            <th>Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var course in Model)
                        {
                            <tr>
                                <td>@course.Id</td>
                                <td>@course.Code</td>
                                <td>@course.Name</td>
                                <td>@course.DurationYears г.</td>
                                <td>@course.StudentGroups?.Count()</td>
                                <td>@course.Disciplines?.Count()</td>
                                <td>
                                    <a asp-action="EditCourse" asp-route-id="@course.Id" class="btn btn-sm btn-warning">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal@(course.Id)">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </td>
                            </tr>

                            <!-- Модальное окно удаления -->
                            <div class="modal fade" id="deleteModal@(course.Id)" tabindex="-1">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <form asp-action="DeleteCourse" method="post">
                                            <input type="hidden" name="id" value="@course.Id" />
                                            <div class="modal-header bg-danger text-white">
                                                <h5 class="modal-title">Подтверждение удаления</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body">
                                                <p>Вы уверены, что хотите удалить курс <strong>@course.Code - @course.Name</strong>?</p>
                                                <p class="text-danger">Это действие нельзя отменить!</p>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                                                <button type="submit" class="btn btn-danger">Удалить</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>