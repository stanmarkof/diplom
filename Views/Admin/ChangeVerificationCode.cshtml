@model diplom.ViewModels.ChangeVerificationCodeViewModel

@{
    ViewData["Title"] = "Настройка кода регистрации";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h3 class="mb-0"><i class="fas fa-key"></i> Настройка кода верификации</h3>
            </div>
            <div class="card-body">
                <form asp-action="ChangeVerificationCode" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label class="form-label">Текущий код</label>
                        <input type="text" class="form-control" value="@Model.CurrentVerificationCode" disabled />
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewVerificationCode" class="form-label">Новый код</label>
                        <input asp-for="NewVerificationCode" class="form-control" required />
                        <span asp-validation-for="NewVerificationCode" class="text-danger"></span>
                        <small class="text-muted">Этот код будут вводить студенты при регистрации</small>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmNewVerificationCode" class="form-label">Подтверждение нового кода</label>
                        <input asp-for="ConfirmNewVerificationCode" class="form-control" required />
                        <span asp-validation-for="ConfirmNewVerificationCode" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <button type="submit" class="btn btn-primary">Сохранить</button>
                        <a asp-action="AllUsers" class="btn btn-secondary">Назад</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>