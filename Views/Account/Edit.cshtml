@model diplom.ViewModels.EditProfileViewModel

@{
    ViewData["Title"] = "Редактирование профиля";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Карточка формы -->
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                <div class="card-header bg-gradient-primary text-white py-3" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-user-edit fa-2x me-3"></i>
                        <div>
                            <h3 class="mb-0 fw-bold">Редактирование профиля</h3>
                            <p class="mb-0 opacity-75 small">Измените свои персональные данные</p>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3"></div>

                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="LastName" class="form-label fw-semibold">
                                    <i class="fas fa-user text-primary me-1"></i>Фамилия
                                </label>
                                <input asp-for="LastName" class="form-control form-control-lg rounded-3" placeholder="Введите фамилию" />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="FirstName" class="form-label fw-semibold">
                                    <i class="fas fa-user text-primary me-1"></i>Имя
                                </label>
                                <input asp-for="FirstName" class="form-control form-control-lg rounded-3" placeholder="Введите имя" />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="MiddleName" class="form-label fw-semibold">
                                    <i class="fas fa-user text-primary me-1"></i>Отчество
                                </label>
                                <input asp-for="MiddleName" class="form-control form-control-lg rounded-3" placeholder="Введите отчество" />
                                <span asp-validation-for="MiddleName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="UserName" class="form-label fw-semibold">
                                    <i class="fas fa-sign-in-alt text-primary me-1"></i>Логин
                                </label>
                                <input asp-for="UserName" class="form-control form-control-lg rounded-3" placeholder="Введите логин" />
                                <span asp-validation-for="UserName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-semibold">
                                    <i class="fas fa-envelope text-primary me-1"></i>Email
                                </label>
                                <input asp-for="Email" class="form-control form-control-lg rounded-3" type="email" placeholder="example@mail.com" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                        </div>

                        <hr class="my-4">

                        <div class="d-flex gap-3 justify-content-end">
                            <a asp-action="Profile" class="btn btn-secondary btn-lg px-4 rounded-pill">
                                <i class="fas fa-times me-2"></i>Отмена
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg px-5 rounded-pill">
                                <i class="fas fa-save me-2"></i>Сохранить
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Подсказка -->
            <div class="text-center mt-4">
                <small class="text-muted">
                    <i class="fas fa-lock me-1"></i> Все данные защищены и не передаются третьим лицам
                </small>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    .form-control-lg {
        border: 1px solid #e0e0e0;
        transition: all 0.3s ease;
    }

        .form-control-lg:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
        }

    .rounded-4 {
        border-radius: 1rem !important;
    }

    .rounded-3 {
        border-radius: 0.75rem !important;
    }

    .btn-lg {
        font-weight: 500;
    }
</style>