@model diplom.Models.Discipline

@{
    ViewData["Title"] = Model?.Name ?? "Дисциплина";
}

@if (Model == null)
{
    <div class="alert alert-danger text-center">
        <i class="fas fa-exclamation-triangle fa-2x mb-3 d-block"></i>
        <h4>Дисциплина не найдена</h4>
        <a asp-action="Index" class="btn btn-secondary mt-3">Назад к списку</a>
    </div>
}
else
{
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <h3 class="mb-0"><i class="fas fa-book-open"></i> @Model.Name</h3>
                <small class="text-muted">
                    <i class="fas fa-graduation-cap"></i> @Model.Course?.Code - @Model.Course?.Name
                    | <i class="fas fa-calendar"></i> @Model.CourseNumber курс, @Model.Semester семестр
                </small>
            </div>
            <div>
                <span class="text-muted me-2">Преподаватели:</span>
                @foreach (var lecturer in Model.DisciplineLecturers)
                {
                    <span class="badge bg-secondary ms-1">@lecturer.Lecturer?.FullName</span>
                }
                <a asp-action="Index" class="btn btn-secondary ms-3">
                    <i class="fas fa-arrow-left"></i> Назад
                </a>
            </div>
        </div>
        <div class="card-body">
            <!-- Описание -->
            <div class="mb-4">
                <h5><i class="fas fa-info-circle"></i> Описание</h5>
                <p>@(string.IsNullOrEmpty(Model.Description) ? "Описание отсутствует" : Model.Description)</p>
            </div>

            <hr />

            <!-- Разделы дисциплины -->
            <div>
                <h5 class="mb-3"><i class="fas fa-folder"></i> Разделы дисциплины</h5>

                @if (Model.Sections != null && Model.Sections.Any())
                {
                    <div class="accordion" id="sectionsAccordion">
                        @foreach (var sect in Model.Sections.OrderBy(s => s.Order))
                        {
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button @(sect.Order != 1 ? "collapsed" : "")" type="button" data-bs-toggle="collapse" data-bs-target="#collapseSection@(sect.Id)">
                                        <div class="d-flex justify-content-between align-items-center w-100 me-3">
                                            <span><i class="fas fa-folder-open"></i> @sect.Name</span>
                                            <div>
                                                <span class="badge bg-secondary me-2">@(sect.Materials?.Count ?? 0) материалов</span>
                                                <span class="badge bg-secondary">@(sect.Tests?.Count ?? 0) тестов</span>
                                            </div>
                                        </div>
                                    </button>
                                </h2>
                                <div id="collapseSection@(sect.Id)" class="accordion-collapse collapse @(sect.Order == 1 ? "show" : "")" data-bs-parent="#sectionsAccordion">
                                    <div class="accordion-body">
                                        <!-- Материалы раздела (горизонтальные карточки) -->
                                        <div class="mb-4">
                                            <h6><i class="fas fa-file-alt"></i> Материалы</h6>
                                            @if (sect.Materials != null && sect.Materials.Any(m => m.IsVisible))
                                            {
                                                <div class="row">
                                                    @foreach (var material in sect.Materials.Where(m => m.IsVisible))
                                                    {
                                                        <div class="col-md-6 col-lg-4 mb-3">
                                                            <div class="card h-100">
                                                                <div class="card-body">
                                                                    <h6 class="card-title">@material.Title</h6>
                                                                    <small class="text-muted">Добавлен: @material.UploadedAt.ToString("dd.MM.yyyy")</small>
                                                                    @if (!string.IsNullOrEmpty(material.Content))
                                                                    {
                                                                        <p class="card-text small mt-2">@(material.Content.Length > 100 ? material.Content.Substring(0, 100) + "..." : material.Content)</p>
                                                                    }
                                                                    @if (!string.IsNullOrEmpty(material.FilePath))
                                                                    {
                                                                        <a href="@material.FilePath" target="_blank" class="btn btn-sm btn-outline-primary mt-2">
                                                                            <i class="fas fa-download"></i> Скачать файл
                                                                        </a>
                                                                    }
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="alert alert-light text-center">Материалы отсутствуют</div>
                                            }
                                        </div>

                                        <!-- Тесты раздела (горизонтальные карточки) -->
                                        <div>
                                            <h6><i class="fas fa-tasks"></i> Тесты</h6>
                                            @if (sect.Tests != null && sect.Tests.Any(t => t.IsPublished && t.IsVisible))
                                            {
                                                <div class="row">
                                                    @foreach (var test in sect.Tests.Where(t => t.IsPublished && t.IsVisible))
                                                    {
                                                        <div class="col-md-6 col-lg-4 mb-3">
                                                            <div class="card h-100 shadow-sm">
                                                                <div class="card-body">
                                                                    <h6 class="card-title">
                                                                        <i class="fas fa-tasks text-info me-1"></i> @test.Title
                                                                    </h6>
                                                                    @if (!string.IsNullOrEmpty(test.Description))
                                                                    {
                                                                        <p class="card-text small text-muted">@(test.Description.Length > 80 ? test.Description.Substring(0, 80) + "..." : test.Description)</p>
                                                                    }
                                                                    <div class="mt-2">
                                                                        <span class="badge bg-secondary">Вопросов: @(test.Questions?.Count ?? 0)</span>
                                                                        <span class="badge bg-secondary">Макс. балл: @test.MaxScore</span>
                                                                        @if (test.Deadline.HasValue)
                                                                        {
                                                                            <span class="badge bg-warning text-dark">Дедлайн: @test.Deadline.Value.ToString("dd.MM.yyyy")</span>
                                                                        }
                                                                    </div>
                                                                </div>
                                                                <div class="card-footer bg-transparent">
                                                                    <a asp-action="TakeTest" asp-route-id="@test.Id" class="btn btn-primary btn-sm w-100">
                                                                        <i class="fas fa-play"></i> Пройти тест
                                                                    </a>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="alert alert-light text-center">Тесты отсутствуют</div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-info text-center">
                        <i class="fas fa-info-circle"></i> Разделы отсутствуют.
                    </div>
                }
            </div>
        </div>
    </div>
}