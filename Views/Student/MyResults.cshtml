@model List<diplom.Models.TestResult>

@{
    ViewData["Title"] = "Мои результаты";
}

<div class="card">
    <div class="card-header">
        <h3 class="mb-0"><i class="fas fa-chart-line"></i> Мои результаты тестов</h3>
    </div>
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Тест</th>
                            <th>Дисциплина</th>
                            <th>Результат</th>
                            <th>Процент</th>
                            <th>Дата прохождения</th>
                            <th>Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var result in Model)
                        {
                            var percentage = (double)result.Score / result.MaxScore * 100;
                            var gradeClass = percentage >= 85 ? "success" : percentage >= 70 ? "info" : percentage >= 50 ? "warning" : "danger";

                            <tr>
                                <td>@result.Test.Title</td>
                                <td>@result.Test.Discipline?.Name</td>
                                <td>@result.Score из @result.MaxScore</td>
                                <td>
                                    <span class="badge bg-@gradeClass">@percentage.ToString("F1")%</span>
                                </td>
                                <td>@result.CompletedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    <a asp-action="TestResult" asp-route-id="@result.Id" class="btn btn-sm btn-info">
                                        <i class="fas fa-eye"></i> Детали
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info text-center">
                <i class="fas fa-info-circle fa-2x mb-3 d-block"></i>
                <h4>Вы ещё не проходили тесты</h4>
                <p class="mb-0">Перейдите в раздел "Мои дисциплины" и пройдите доступные тесты.</p>
            </div>
        }
    </div>
</div>